*.h linguist-language=C++
LICENSE text eol=lf

# Analysis docs and their build tools: pin LF in the working tree too.
# core.autocrlf=true is common on Windows, and without this a fresh checkout
# writes CRLF, which makes docs/src/tools/verify.py report a false failure.
docs/**/*.md text eol=lf
docs/**/*.py text eol=lf

# E2E run evidence: byte-exact checkouts. core.autocrlf=true would rewrite
# the gate logs to CRLF and break the recorded SHA-256 (same trap as docs/src).
# Round-12/13 surfaced the same defect on the newer run roots: pin ALL runs.
docs/tests/runs/** -text

# Frozen plans and test-plan files are hash-bound by gates (performance-method
# methodSha256, planning/cases/contracts bytes): pin them byte-exact too.
docs/plans/** -text
docs/tests/receiver-ux-v2/** -text
docs/design-catalog/receiver-ux-v2/** -text

# Delivery copies under product/ are hash-bound by DELIVERY-MANIFEST.txt and
# the release notes; keep fresh checkouts byte-identical to the zip contents.
product/** -text

# Round-16 red-logs carry byte-bound evidence (the pre-fix tool copy and its
# recorded SHA-256); pin them byte-exact like the run roots.
docs/dev-pipeline/receiver-ux-v2/red-logs/** -text
