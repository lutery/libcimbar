  "implementationCases": [
    {
      "id": "R-01",
      "scenario": "旧seq、相同frameId或冻结后的当前帧",
      "expected": "UX-03返回19007且bytes/revision/lastData不变；原业务结果独立处理"
    },
    {
      "id": "R-02",
      "scenario": "相同begin重复与新seq开始",
      "expected": "重复不清零；新seq所有UX字段和桶清空；旧tick无效"
    },
    {
      "id": "R-03",
      "scenario": "同流重复比例、增加、多流后回single、有效比例回退",
      "expected": "重复无增；新值推进；多流/回退锁歧义至新会话"
    },
    {
      "id": "R-04",
      "scenario": "数据落于0/249.9/250/2999.9/3000ms桶边界",
      "expected": "按12桶原点定义精确归属；无数据后不超3秒归零"
    },
    {
      "id": "R-05",
      "scenario": "收到data但report缺失或格式失败",
      "expected": "字节速率可更新，百分比隐藏；不改frame outcome或业务错误"
    },
    {
      "id": "R-06",
